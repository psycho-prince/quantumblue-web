generator client {
  provider = "prisma-client-js"
  output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  apiKeys   ApiKey[]
  scans     Scan[]
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyHash        String       @unique
  label          String
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
}

model Scan {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  targetName      String
  bomSerialNumber String
  rawBom          Json
  createdAt       DateTime     @default(now())
  findings        Finding[]
  anomalies       Anomaly[]
}

model Finding {
  id                       String  @id @default(uuid())
  scanId                   String
  scan                     Scan    @relation(fields: [scanId], references: [id])
  bomRef                   String
  name                     String
  primitive                String
  parameterSetIdentifier   String?
  nistQuantumSecurityLevel Int?
  location                 String
}

model Anomaly {
  id             String   @id @default(uuid())
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id])
  baselineScanId String
  kind           String
  description    String
  severity       String
  createdAt      DateTime @default(now())
}
