generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  apiKeys    ApiKey[]
  scans      Scan[]
  auditEvents AuditEvent[]
  
  // Billing Relations
  billingCustomer BillingCustomer?
  subscriptions   Subscription[]
  payments        PaymentTransaction[]
  invoices        Invoice[]
}

model ApiKey {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyHash        String       @unique
  label          String
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?
}

model Scan {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  targetName     String
  bomSerialNumber String
  rawBom         Json
  createdAt      DateTime      @default(now())
  findings       Finding[]
  anomalies      Anomaly[]
}

model Finding {
  id                       String   @id @default(uuid())
  scanId                   String
  scan                     Scan     @relation(fields: [scanId], references: [id])
  bomRef                   String
  name                     String
  primitive                String
  parameterSetIdentifier   String?
  nistQuantumSecurityLevel Int?
  location                 String
}

model Anomaly {
  id             String   @id @default(uuid())
  scanId         String
  scan           Scan     @relation(fields: [scanId], references: [id])
  baselineScanId String
  kind           String
  description    String
  severity       String
  createdAt      DateTime @default(now())
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  action         String
  details        Json
  createdAt      DateTime     @default(now())
}

// --- BILLING MODELS ---

model BillingCustomer {
  id                   String       @id @default(uuid())
  clerkOrgId           String       @unique
  organization         Organization @relation(fields: [clerkOrgId], references: [id])
  clerkUserId          String?
  razorpayCustomerId   String       @unique
  zohoCustomerId       String?      @unique
  email                String
  name                 String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model Subscription {
  id                     String       @id @default(uuid())
  clerkOrgId             String
  organization           Organization @relation(fields: [clerkOrgId], references: [id])
  razorpayCustomerId     String
  razorpaySubscriptionId String       @unique
  razorpayPlanId         String
  planKey                String
  status                 String
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean      @default(false)
  cancelledAt            DateTime?
  endedAt                DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model PaymentTransaction {
  id                     String       @id @default(uuid())
  clerkOrgId             String
  organization           Organization @relation(fields: [clerkOrgId], references: [id])
  razorpayPaymentId      String       @unique
  razorpayOrderId        String?
  razorpaySubscriptionId String?
  amount                 Int
  currency               String
  status                 String
  method                 String?
  email                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model Invoice {
  id                 String       @id @default(uuid())
  clerkOrgId         String
  organization       Organization @relation(fields: [clerkOrgId], references: [id])
  razorpayInvoiceId  String?      @unique
  zohoInvoiceId      String?      @unique
  invoiceNumber      String?
  amount             Int
  currency           String
  status             String
  invoiceUrl         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String   @unique
  eventType   String
  processed   Boolean  @default(false)
  processedAt DateTime?
  createdAt   DateTime @default(now())
}
